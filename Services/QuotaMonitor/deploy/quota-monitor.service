[Unit]
Description=Quota Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=quota-monitor
StateDirectoryMode=0700
EnvironmentFile=/etc/quota-monitor/monitor.env
LoadCredential=config:/etc/quota-monitor/config.json
LoadCredential=state-key:/etc/quota-monitor/credentials/state-key
LoadCredential=cpa-key:/etc/quota-monitor/credentials/cpa-key
LoadCredential=bridge-token:/etc/quota-monitor/credentials/bridge-token
LoadCredential=apns-key:/etc/quota-monitor/credentials/apns-key
ExecStart=/usr/local/libexec/quota-monitor-start
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
LimitCORE=0
MemoryHigh=384M
MemoryMax=512M
TasksMax=64
CPUQuota=50%

[Install]
WantedBy=multi-user.target
