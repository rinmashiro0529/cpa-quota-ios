#!/bin/sh
set -eu
: "${CREDENTIALS_DIRECTORY:?missing systemd credentials}"
QUOTA_MONITOR_STATE_KEY=$(cat "$CREDENTIALS_DIRECTORY/state-key")
QUOTA_MONITOR_CPA_KEY=$(cat "$CREDENTIALS_DIRECTORY/cpa-key")
QUOTA_MONITOR_BRIDGE_TOKEN=$(cat "$CREDENTIALS_DIRECTORY/bridge-token")
QUOTA_MONITOR_APNS_KEY=$(cat "$CREDENTIALS_DIRECTORY/apns-key")
export QUOTA_MONITOR_STATE_KEY QUOTA_MONITOR_CPA_KEY QUOTA_MONITOR_BRIDGE_TOKEN QUOTA_MONITOR_APNS_KEY
exec /usr/local/bin/quota-monitor -config "$CREDENTIALS_DIRECTORY/config"
